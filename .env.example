# ============================================
# PRism — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ============================================

# Bob Shell — Required
# Generate at: bob.ibm.com -> Settings -> API Keys -> Create Inference Key
# NOTE: The correct variable name is BOB_API_KEY (confirmed in smoke test)
BOB_API_KEY=your_bob_inference_api_key_here

# GitHub — Required
# Generate at: github.com -> Settings -> Developer settings -> Personal access tokens
# Scopes needed: repo (read)
GITHUB_TOKEN=your_github_pat_here

# Database
DATABASE_URL=sqlite:///./prism.db

# Bob Shell behavior (confirmed in smoke test Fase 0.5)
# Command: bob run "<prompt>" -f json --mode ask
BOB_MAX_TIMEOUT_SECONDS=45
BOB_MODE=ask

# watsonx (optional — not used as primary engine)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
