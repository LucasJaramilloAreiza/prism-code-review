# ============================================
# BOB AI ASSISTANT - SECURITY IGNORE PATTERNS
# ============================================
# Prevents Bob from logging credentials in session history

# Bob Shell API Key — all known patterns
*BOB_API_KEY*
*BOB_API_KEY*
*bob_api_key*
bob_prod_bob-apikey_*

# IBM Cloud API Keys
*IBM_CLOUD_API_KEY*
*IBMCLOUD_API_KEY*
*apikey*
*api-key*
*api_key*

# Generic Credentials
*API_KEY*
*ACCESS_TOKEN*
*SECRET_KEY*
*PASSWORD*
*SECRET*
*CREDENTIAL*
*PRIVATE_KEY*
*AUTH_TOKEN*
*BEARER_TOKEN*

# Environment Files
.env
.env.*
*.env
env.local

# Private Keys
*.pem
*.key
id_rsa
id_dsa

# Command Outputs with credentials
*export *API_KEY*
*echo $*API_KEY*

# ============================================
# DO NOT REMOVE ABOVE PATTERNS
# ============================================

