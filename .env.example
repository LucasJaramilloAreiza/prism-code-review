# ============================================
# PRism — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ============================================

# Bob Shell — Required
# Generate at: bob.ibm.com → Settings → API Keys → Create Inference Key
BOBSHELL_API_KEY=your_bob_inference_api_key_here

# GitHub — Required
# Generate at: github.com → Settings → Developer settings → Personal access tokens
# Scopes needed: repo (read)
GITHUB_TOKEN=your_github_pat_here

# Database
DATABASE_URL=sqlite:///./prism.db

# Bob Shell behavior
BOB_MAX_TIMEOUT_SECONDS=45
BOB_CHAT_MODE=ask

# watsonx (optional — not used as primary engine)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
